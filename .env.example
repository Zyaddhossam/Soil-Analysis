# Environment Configuration
# Copy this file to .env and fill in your values

# Application
APP_NAME="Soil Analysis API"
APP_VERSION="1.0.0"
DEBUG=false
ENVIRONMENT=development

# API Configuration
API_PREFIX=/api
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Model Paths (relative to project root or absolute)
# Leave empty to use defaults from artifacts/ directory
SOIL_CLASSIFIER_MODEL_PATH=
FERTILITY_PREDICTOR_MODEL_PATH=

# MLflow Configuration
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=soil-analysis
# MLFLOW_TRACKING_URI=http://localhost:5000  # For remote MLflow server

# Inference Settings
BATCH_SIZE=32
CONFIDENCE_THRESHOLD=0.5
